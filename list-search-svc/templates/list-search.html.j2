<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Song Catalog</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .navbar {
            background-color: #343a40;
        }

        .navbar-brand, .navbar-nav .nav-link {
            color: #fff;
        }

        h1 {
            text-align: center;
            margin-top: 30px;
            color: #343a40;
        }

        hr {
            border-color: #343a40;
            width: 80%;
        }

        .input-group {
            width: 80%;
            margin: 0 auto;
        }

        .btn-outline-primary {
            color: #007bff;
            border-color: #007bff;
        }

        .btn-outline-primary:hover {
            color: #0056b3;
            border-color: #0056b3;
        }

        .card {
            margin-top: 50px;
        }

        .card-title {
            color: #343a40;
        }

        .list-group-item {
            background-color: #f8f9fa;
            border-color: #dee2e6;
            margin-top: 10px;
        }

        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">My Music</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/get-catalog">Song Catalog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/upload-song">Upload Song</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/play-song">Get Song</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <h1>Search Song</h1>
        <hr>

        <!-- Search Form -->
        <form action="get-catalog" method="post">
            <div class="input-group">
                <input type="text" class="form-control" id="search"  name="search" placeholder="Search by Song Name">
                <div class="input-group-append">
                    <button class="btn btn-outline-primary" type="submit">Search</button>
                </div>
            </div>
        </form>

        <!-- Song List -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">All Songs</h5>
                <ul class="list-group">
                    {% for song_id, song_details in catalog.items() %}
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>{{ song_details.name }}</strong> by {{ song_details.artist }} (Album: {{ song_details.album }} | Year: {{ song_details.year }})
                                </div>
                                <a href="/get-song?song_id={{ song_id }}">Play</a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>



